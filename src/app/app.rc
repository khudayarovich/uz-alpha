#pragma code_page(65001)
#include <winres.h>
#include "resource.h"
#include "../common/version.h"

IDI_APP ICON "../../assets/uzalpha.ico"

1 RT_MANIFEST "app.manifest"

// The installer payload (built before the app, see build.cmd).
IDR_TIP_X64   RCDATA "../../build/tip/x64/UzAlphaTip.dll"
IDR_TIP_X86   RCDATA "../../build/tip/x86/UzAlphaTip.dll"
IDR_KBD_X64   RCDATA "../../build/kbd/x64/kbduzalp.dll"
IDR_KBD_WOW64 RCDATA "../../build/kbd/wow64/kbduzalp.dll"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
PRODUCTVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Farrukh Yuldashev"
            VALUE "FileDescription", "UzAlpha — yangi özbek alifbosi klaviaturasi"
            VALUE "FileVersion", UZA_VER_STR
            VALUE "InternalName", "UzAlpha"
            VALUE "LegalCopyright", "(c) 2026 Farrukh Yuldashev"
            VALUE "OriginalFilename", "UzAlpha.exe"
            VALUE "ProductName", "UzAlpha"
            VALUE "ProductVersion", UZA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
