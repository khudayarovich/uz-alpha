#pragma code_page(65001)
#include <winres.h>
#include "../common/version.h"

// The icons Windows shows for the two keyboards in its switcher: just the
// letters UZA and UZM, so they read like Windows' own language codes.
// Their order here is their index in RegisterProfile (0 = UZA, 1 = UZM).
1 ICON "../../assets/uza.ico"
2 ICON "../../assets/uzm.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
PRODUCTVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Farrukh Yuldashev"
            VALUE "FileDescription", "UzAlpha — Özbekça (lotin) input method"
            VALUE "FileVersion", UZA_VER_STR
            VALUE "InternalName", "UzAlphaTip"
            VALUE "LegalCopyright", "(c) 2026 Farrukh Yuldashev"
            VALUE "OriginalFilename", "UzAlphaTip.dll"
            VALUE "ProductName", "UzAlpha"
            VALUE "ProductVersion", UZA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
