#pragma code_page(65001)
#include <winres.h>
#include "../common/version.h"

// File icon only. The profile is registered without an icon on purpose, so
// the taskbar shows the language code rather than a logo.
1 ICON "../../assets/uzalpha.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
PRODUCTVERSION UZA_VER_MAJOR, UZA_VER_MINOR, UZA_VER_PATCH, 0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Farrukh Yuldashev"
            VALUE "FileDescription", "UzAlpha — Özbekça (lotin, avtomatik) input method"
            VALUE "FileVersion", UZA_VER_STR
            VALUE "InternalName", "UzAlphaTip"
            VALUE "LegalCopyright", "(c) 2026 Farrukh Yuldashev"
            VALUE "OriginalFilename", "UzAlphaTip.dll"
            VALUE "ProductName", "UzAlpha"
            VALUE "ProductVersion", UZA_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
